    <bpmn:sequenceFlow id="Flow_0ncqnc9" name="Зарегистрироваться" sourceRef="Gateway_1sqn06u" targetRef="Activity_1lc2hl6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${radio_auth_menu == "sign_up_value"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03cjyvm" sourceRef="Activity_1ojx2o4" targetRef="Activity_023jwrp" />
    <bpmn:userTask id="Activity_0yrqxf7" name="Отобразить сообщение об ошибке">
