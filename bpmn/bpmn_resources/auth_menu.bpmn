    <bpmn:sequenceFlow id="Flow_05im1ru" name="Войти" sourceRef="Gateway_1sqn06u" targetRef="Activity_1ojx2o4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${radio_auth_menu == "sign_in_value"}</bpmn:conditionExpression>
