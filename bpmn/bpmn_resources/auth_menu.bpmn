    <bpmn:serviceTask id="Activity_0rt1haf" name="Выполнить регистрацию в систему" camunda:type="external" camunda:topic="sign-up">
      <bpmn:incoming>Flow_0tk5g64</bpmn:incoming>
      <bpmn:outgoing>Flow_1e5x9pj</bpmn:outgoing>
